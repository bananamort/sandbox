<Project>
  <!--
    Directory.Build.targets (auto-imported by every project AFTER the C++
    props have composed IncludePath/LibraryPath).

    Purpose: guarantee the VC ATLMFC headers/libs are reachable. The CI
    runner image ships multiple MSVC toolsets and the ATLMFC component can
    land under a version directory other than the one the v143 toolset
    resolves; MSBuild also derives INCLUDE/LIB for cl.exe from these
    properties rather than the process environment, so exporting INCLUDE
    in the workflow cannot fix it.

    ATLMFC_ROOT is exported by the build workflow's detection step (points
    at the MSVC toolset dir that actually contains atlmfc\). Guarded on
    non-empty so local builds are untouched.
  -->
  <PropertyGroup Condition="'$(ATLMFC_ROOT)' != ''">
    <IncludePath>$(ATLMFC_ROOT)\atlmfc\include;$(IncludePath)</IncludePath>
    <LibraryPath>$(ATLMFC_ROOT)\atlmfc\lib\x86;$(ATLMFC_ROOT)\atlmfc\lib;$(LibraryPath)</LibraryPath>
    <!-- Forced into every TU ahead of all sources (/FI): declares the Win8+
         loader surface that the only installed ATLMFC (14.51) requires,
         independent of which Windows headers win resolution (vendored
         7.1-era tree shadows the platform SDK on /I; modern SDK gates the
         API behind _WIN32_WINNT >= 0x0602). See ci_atl_loader_shim.h and
         CI runs 32704355280/32743525757/32746195933. -->
    <ForcedIncludeFiles>$(MSBuildThisFileDirectory)ci_atl_loader_shim.h</ForcedIncludeFiles>
  </PropertyGroup>

  <!--
    The PropertyGroup above alone is NOT sufficient: /FI is driven by ClCompile
    ITEM METADATA (ForcedIncludeFiles), which a bare property never populates -
    run 32749616940 still failed with the identical atlcore.h(663) class under
    the property-only wiring. Inject the metadata directly before compilation.
  -->
  <Target Name="ForceATLLoaderShimInclude"
          BeforeTargets="ClCompile"
          Condition="'$(ATLMFC_ROOT)' != ''">
    <ItemGroup>
      <ClCompile>
        <ForcedIncludeFiles>$(MSBuildThisFileDirectory)ci_atl_loader_shim.h;%(ForcedIncludeFiles)</ForcedIncludeFiles>
      </ClCompile>
    </ItemGroup>
  </Target>
</Project>
